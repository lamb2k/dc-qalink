      "description": "width"
     },
     "h": {
      "type": "integer",
      "description": "height"
     },
     "label": {
      "type": "string",
      "description": "what it is"
     },
     "bytes": {
      "type": "integer",
      "description": "PNG size"
     },
     "id": {
      "type": "string",
      "description": "still id"
     },
     "tier": {
      "type": "string",
      "description": "console, flycast or mock"
