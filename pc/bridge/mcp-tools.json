     "args": {
      "type": "string",
      "description": "arguments"
     },
     "state": {
      "type": "string",
      "description": "the loader's run state",
      "enum": [
       "queued",
       "sending",
       "running",
       "done",
       "crashed",
       "timeout",
       "reset",
       "lost",
       "refused"
      ]
     },
     "times": {
      "type": "object",
      "description": "seconds: push_s, run_s, report_s, total_s"
     },
     "way_back": {
      "type": "string",
      "description": "stub, watchdog or power"
     },
     "queued_at": {
      "type": "string",
      "description": "ISO time"
     },
     "ended_at": {
      "type": "string",
      "description": "ISO time"
     },
     "by": {
      "type": "string",
      "description": "who sent it"
     },
     "device": {
      "type": "string",
      "description": "device it ran on"
     },
     "tier": {
      "type": "string",
      "description": "console, flycast or mock"
     },
     "summary": {
      "type": "object",
      "properties": {
       "exit": {
        "description": "exit code (integer), null while running"
       },
       "state": {
        "type": "string",
        "description": "run state"
       },
       "seconds": {
        "type": "number",
        "description": "run time"
       },
       "pictures": {
        "type": "integer",
        "description": "pictures drawn"
       },
       "tier": {
        "type": "string",
        "description": "console, flycast or mock"
       },
       "numbers": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "label": {
           "type": "string",
           "description": "name"
          },
          "value": {
           "type": "number",
           "description": "value"
          },
          "unit": {
           "type": "string",
           "description": "unit"
          },
          "tier": {
           "type": "string",
           "description": "tier"
          }
         },
         "required": []
        }
       },
       "notes": {
        "type": "array",
        "items": {
         "type": "string",
         "description": "note"
        }
       },
       "crash": {
        "type": "object",
        "description": "crash: event, pc, pr, sp"
       }
      },
      "required": []
     },
     "crash": {
      "type": "object",
      "description": "crash: event, pc, pr, sp"
     },
     "error": {
      "type": "string",
      "description": "why it did not run or come back"
     },
     "stills": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "still id"
      }
     },
     "report": {
      "type": "string",
      "description": "the report text (get_run)"
     }
    },
    "required": [
     "id",
     "program",
     "state",
     "tier"
    ]
   }
  },
