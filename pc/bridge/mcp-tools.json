{
 "version": "0.3.0",
 "bridgeApi": "1.0",
 "tools": [
  {
   "name": "link_status",
   "title": "Link status",
   "level": "read",
   "bridge": "GET /v0/status",
   "description": "Is a Dreamcast or Flycast linked, which one, over what (broadband adapter or modem), and which session is recording. Call this first.",
   "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "contract": {
      "type": "integer",
      "description": "bridge contract (1)"
     },
     "bridge": {
      "type": "string",
      "description": "bridge program and version"
     },
     "link": {
      "type": "string",
      "description": "the loader's link state",
      "enum": [
       "searching",
       "up",
       "lost",
       "refused"
      ]
     },
     "device": {
      "description": "the device this bridge owns: kind, tier, name, transport, address, loader, program"
     },
     "session": {
      "type": "string",
      "description": "session being recorded"
     },
     "rate_bps": {
      "type": "number",
      "description": "bytes a second from the console"
     },
     "mode": {
      "type": "string",
      "description": "full (adapter) or summary (modem)",
      "enum": [
       "full",
       "summary"
      ]
     },
     "tier": {
      "type": "string",
      "description": "where the numbers come from",
      "enum": [
       "console",
       "flycast",
       "mock"
      ]
     }
    },
    "required": [
     "contract",
     "link",
     "mode",
     "tier"
    ]
   }
  },
  {
   "name": "list_devices",
   "title": "List devices",
   "level": "read",
   "bridge": "GET /v0/devices, GET /v0/discovery",
   "description": "Devices the bridge knows: Flycast on this PC and consoles whose loader it has heard, with address and loader version.",
   "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "devices": {
      "type": "array",
      "items": {
       "type": "object",
       "description": "device: id, kind, tier, name, transport, address, loader"
      }
     },
     "discovery": {
      "type": "array",
      "items": {
       "type": "object",
       "description": "a loader heard: address, kind, beacons, chosen"
      }
     }
    },
    "required": [
     "devices"
    ]
   }
  },
  {
   "name": "push_build",
   "title": "Push a build",
   "level": "run",
   "bridge": "POST /v0/runs",
   "description": "Send a program (ELF or BIN) to the linked device and start it. Give a file path on the bridge's PC or the bytes as base64. The bridge checks the hash on receipt. Returns the queued run; use get_run or run_and_wait for its report.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "description": "path of the build on the bridge's PC (local MCP only)"
     },
     "base64": {
      "type": "string",
      "description": "the build bytes, base64"
     },
     "name": {
      "type": "string",
      "description": "file name to show (default: from the path)"
     },
     "device": {
      "type": "string",
      "description": "device kind to run on",
      "enum": [
       "flycast",
       "console"
      ]
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "description": "run id (opaque)"
     },
     "program": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "description": "build file name"
       },
       "sha256": {
        "type": "string",
        "description": "hash of the bytes received"
       },
       "bytes": {
        "type": "integer",
        "description": "size"
       }
      },
      "required": []
     },
     "args": {
      "type": "string",
      "description": "arguments"
     },
     "state": {
      "type": "string",
      "description": "the loader's run state",
      "enum": [
       "queued",
       "sending",
       "running",
       "done",
       "crashed",
       "timeout",
       "reset",
       "lost",
       "refused"
      ]
     },
     "times": {
      "type": "object",
      "description": "seconds: push_s, run_s, report_s, total_s"
     },
     "way_back": {
      "type": "string",
      "description": "stub, watchdog or power"
     },
     "queued_at": {
      "type": "string",
      "description": "ISO time"
     },
     "ended_at": {
      "type": "string",
      "description": "ISO time"
     },
     "by": {
      "type": "string",
      "description": "who sent it"
     },
     "device": {
      "type": "string",
      "description": "device it ran on"
     },
     "tier": {
      "type": "string",
      "description": "console, flycast or mock"
     },
     "summary": {
      "type": "object",
      "properties": {
       "exit": {
        "description": "exit code (integer), null while running"
       },
       "state": {
        "type": "string",
        "description": "run state"
       },
       "seconds": {
        "type": "number",
        "description": "run time"
       },
       "pictures": {
        "type": "integer",
        "description": "pictures drawn"
       },
       "tier": {
        "type": "string",
        "description": "console, flycast or mock"
       },
       "numbers": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "label": {
           "type": "string",
           "description": "name"
          },
          "value": {
           "type": "number",
           "description": "value"
          },
          "unit": {
           "type": "string",
           "description": "unit"
          },
          "tier": {
           "type": "string",
           "description": "tier"
          }
         },
         "required": []
        }
       },
       "notes": {
        "type": "array",
        "items": {
         "type": "string",
         "description": "note"
        }
       },
       "crash": {
        "type": "object",
        "description": "crash: event, pc, pr, sp"
       }
      },
      "required": []
     },
     "crash": {
      "type": "object",
      "description": "crash: event, pc, pr, sp"
     },
     "error": {
      "type": "string",
      "description": "why it did not run or come back"
     },
     "stills": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "still id"
      }
     },
     "report": {
      "type": "string",
      "description": "the report text (get_run)"
     }
    },
    "required": [
     "id",
     "program",
     "state",
     "tier"
    ]
   }
  },
  {
